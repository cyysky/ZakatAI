# Application
APP_NAME=AI Zakat Management System
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=6789

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mawp_ai

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage (relative to project root)
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE=10485760

# AI API Configuration (External AI Server)
AI_API_URL=http://localhost:9999
AI_API_KEY=your-api-key-here

# AI Models
LLM_MODEL=qwen3.5-397b-a17b-fp8-thinking
EMBEDDING_MODEL=qwen3-vl-embedding-8b
ASR_MODEL=qwen3-asr-1.7b

# Vector Store (relative to project root)
CHROMA_DB_DIR=./backend/chroma_db

# Frontend API URL
VITE_API_URL=http://localhost:6789

# Scoring
ELIGIBILITY_THRESHOLD=0.5
SIMILARITY_THRESHOLD=0.85